<UserControl x:Class="Gamma931.App.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:Gamma931.Core.Models;assembly=Gamma931.Core"
             xmlns:game="clr-namespace:Gamma931.Core.Game;assembly=Gamma931.Core"
             xmlns:controls="clr-namespace:Gamma931.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="#FFBFBFBF" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="RowSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="#FFBFBFBF" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Horizontal-carousel card row: art card on top, everything else (name/subtitle/body/footer)
             rendered inside CardFaceView's own text panel underneath the art, per card. -->
        <ItemsPanelTemplate x:Key="CarouselPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="10">

        <!-- ============ SETUP ============ -->
        <StackPanel Visibility="{Binding IsSetupPhase, Converter={StaticResource BoolToVis}}" MaxWidth="500" HorizontalAlignment="Left">
            <TextBlock Text="New Game" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Players:" Width="90" VerticalAlignment="Center" />
                <ComboBox Width="80" ItemsSource="{Binding PlayerCountOptions}" SelectedItem="{Binding PlayerCount}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Difficulty:" Width="90" VerticalAlignment="Center" />
                <ComboBox Width="120" ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding SelectedDifficulty}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding SetupRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox Width="150" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <ComboBox Width="220"
                                      ItemsSource="{Binding DataContext.AvailableCharacters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding Character}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Start Game" Command="{Binding StartGameCommand}" Margin="0,10,0,0" Padding="10,4" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============ GAME ============ -->
        <Grid Visibility="{Binding IsGameActive, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- status bar -->
            <Border Grid.Row="0" Padding="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding CurrentLocationCard, Converter={StaticResource CardImage}}"
                           Width="96" Height="134" Margin="0,0,10,0"
                           Visibility="{Binding CurrentLocationCard, Converter={StaticResource NullToCollapsed}}" />
                    <Image Source="{Binding CurrentBossCard, Converter={StaticResource CardImage}}"
                           Width="96" Height="134" Margin="0,0,14,0"
                           Visibility="{Binding CurrentBossCard, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="Bold" Text="{Binding PhaseText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding RoundText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding LocationText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding BossText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="New Game" Command="{Binding NewGameCommand}" Padding="6,2" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- main content: [crew/minions over round structure] | event log -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="360" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="320" MinWidth="220" MaxWidth="560" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220" MinHeight="140" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <!-- crew + minions -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="240" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="3*" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Crew" FontWeight="Bold" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding PlayersDisplay}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Player" Binding="{Binding Name}" />
                                    <DataGridTextColumn Header="Character" Binding="{Binding CharacterName}" />
                                    <DataGridTextColumn Header="HP" Binding="{Binding CurrentHp}" />
                                    <DataGridTextColumn Header="Position" Binding="{Binding Position}" />
                                    <DataGridTextColumn Header="Hand" Binding="{Binding HandCount}" />
                                    <DataGridCheckBoxColumn Header="Alive" Binding="{Binding IsAlive}" />
                                    <DataGridCheckBoxColumn Header="Up Next" Binding="{Binding IsUpNext}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="6" Style="{StaticResource ColumnSplitter}" />

                        <DockPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Minions" FontWeight="Bold" Margin="0,0,0,4" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding MinionsDisplay}" ItemsPanel="{StaticResource CarouselPanel}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:CrabMinionCard}">
                                            <controls:CardFaceView Card="{Binding}" Title="{Binding Name}"
                                                                    Subtitle="Crab Minion" FlavorText="{Binding FlavorText}" FooterText="1 HP"
                                                                    AccentBrush="#FFA1522C"
                                                                    Width="140" Height="196" Margin="0,0,10,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <GridSplitter Grid.Row="1" Height="6" Style="{StaticResource RowSplitter}" />

                    <!-- round-structure / combat actions -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="Round Structure" FontWeight="Bold" Margin="0,0,0,4" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Reveal Location" Command="{Binding RevealLocationCommand}" Margin="0,0,6,6" Padding="8,4" />
                                <Button Content="Draw Equipment" Command="{Binding DrawEquipmentCommand}" Margin="0,0,6,6" Padding="8,4" />
                                <Button Content="Draw Boss" Command="{Binding DrawBossCommand}" Margin="0,0,6,6" Padding="8,4" />
                                <Button Content="Draw Minions" Command="{Binding DrawMinionsCommand}" Margin="0,0,6,6" Padding="8,4" />
                                <Button Content="Advance to Next Round" Command="{Binding AdvanceRoundCommand}" Margin="0,0,6,6" Padding="8,4" />
                            </WrapPanel>

                            <!-- Every living crab acts each cycle: boss attacks, then each player takes an
                                 equipment turn, then every living minion attacks — repeating until all crabs
                                 or all players are dead (no crab action deck). -->
                            <TextBlock Text="Combat Cycle" FontWeight="Bold" Margin="0,0,0,4" />

                            <StackPanel Visibility="{Binding HasPendingCrabAttack, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                <TextBlock Text="{Binding PendingAttackText}" Foreground="DarkRed" Margin="0,2,0,6" />
                                <WrapPanel>
                                    <Button Content="Take the Hit" Command="{Binding CrabAttackTakeHitCommand}" Margin="0,0,6,6" Padding="8,4" />
                                    <ItemsControl ItemsSource="{Binding BlockableCards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:EquipmentCard}">
                                                <Button Content="{Binding Name, StringFormat='Block with {0}'}"
                                                        Command="{Binding DataContext.CrabAttackBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,6,6" Padding="8,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding CurrentTurnText}" FontWeight="Bold" Margin="0,4,0,4"
                                       Visibility="{Binding IsPlayerTurnsPhase, Converter={StaticResource BoolToVis}}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                                <ItemsControl ItemsSource="{Binding CurrentHand}" ItemsPanel="{StaticResource CarouselPanel}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:EquipmentCard}">
                                            <StackPanel Width="220" Margin="0,0,14,0" VerticalAlignment="Top">
                                                <controls:CardFaceView Card="{Binding}" Title="{Binding Name}"
                                                                        Subtitle="{Binding EquipmentType}"
                                                                        BodyText="{Binding EffectText}"
                                                                        AccentBrush="#FF6C6C93"
                                                                        Width="200" Height="290" HorizontalAlignment="Center" />
                                                <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Center">
                                                    <Button Content="Hit Boss"
                                                            Command="{Binding DataContext.HitBossCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,6,6" Padding="8,4">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EquipmentType}" Value="Melee">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EquipmentType}" Value="Ranged">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Hit Minions"
                                                            Command="{Binding DataContext.HitMinionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,6,6" Padding="8,4">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EquipmentType}" Value="Melee">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EquipmentType}" Value="Ranged">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Heal Self"
                                                            Command="{Binding DataContext.HealSelfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,6,6" Padding="8,4">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EquipmentType}" Value="Healing">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <!-- Medic passive: with a Medic alive, a Healing card can also target a
                                                         teammate — HealableTeammates is empty (so this renders nothing)
                                                         whenever no Medic is in the crew. Tag carries this specific card
                                                         (this template's own DataContext) down to the nested Player template. -->
                                                    <ItemsControl Tag="{Binding}"
                                                                  ItemsSource="{Binding DataContext.HealableTeammates, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EquipmentType}" Value="Healing">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type game:Player}">
                                                                <Button Content="{Binding Name, StringFormat='Heal {0}'}"
                                                                        Command="{Binding DataContext.HealTeammateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Margin="0,0,6,6" Padding="8,4">
                                                                    <Button.CommandParameter>
                                                                        <MultiBinding Converter="{StaticResource HealArgs}">
                                                                            <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                            <Binding Path="." />
                                                                        </MultiBinding>
                                                                    </Button.CommandParameter>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock VerticalAlignment="Center" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="Text" Value="" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EquipmentType}" Value="Protection">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Text" Value="Held — plays only as a block against a crab attack." />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </WrapPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Guaranteed action once a player's hand is empty (RULES.md "Weapons & Modifiers"):
                                 swing the default melee weapon instead of playing a card. -->
                            <WrapPanel Visibility="{Binding IsPlayerTurnsPhase, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                <Button Content="Swing Default Melee — Boss" Command="{Binding AttackMeleeBossCommand}"
                                        Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="Swing Default Melee — Minions" Command="{Binding AttackMeleeMinionsCommand}"
                                        Padding="8,4" />
                            </WrapPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <GridSplitter Grid.Column="1" Width="6" Style="{StaticResource ColumnSplitter}" />

                <!-- event log -->
                <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="Gray" Padding="10,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="Bold" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding LogLines}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
