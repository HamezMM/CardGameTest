<Window x:Class="Gamma931.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Gamma931.App.Views"
        Title="Gamma-931 Playtester" Height="800" Width="1200">
    <TabControl>
        <TabItem Header="Play">
            <views:GameView DataContext="{Binding Game}" />
        </TabItem>
        <TabItem Header="Card Browser">
            <views:CardBrowserView DataContext="{Binding CardBrowser}" />
        </TabItem>
    </TabControl>
</Window>
