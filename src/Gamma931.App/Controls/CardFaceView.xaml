<UserControl x:Class="Gamma931.App.Controls.CardFaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Gamma931.App.Controls"
             mc:Ignorable="d"
             x:Name="Root"
             Width="200" Height="300"
             d:DesignHeight="300" d:DesignWidth="200">
    <UserControl.Resources>
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    </UserControl.Resources>

    <Border CornerRadius="10" Background="#FF1E1E24" BorderBrush="{Binding AccentBrush, ElementName=Root}" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Art -->
            <Border Grid.Row="0" CornerRadius="7" ClipToBounds="True" Margin="0,0,0,4">
                <Image Source="{Binding Card, ElementName=Root, Converter={StaticResource CardImage}}"
                       Stretch="UniformToFill" />
            </Border>

            <!-- Text panel -->
            <StackPanel Grid.Row="1" Margin="6,0,6,6">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           FontWeight="Bold" FontSize="14" Foreground="White"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                           FontStyle="Italic" FontSize="11" Foreground="#FFB9BEC9"
                           Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource EmptyToCollapsed}}"
                           Margin="0,1,0,0" />
                <TextBlock Text="{Binding FlavorText, ElementName=Root}"
                           FontStyle="Italic" FontSize="10" Foreground="#FF8D93A1" TextWrapping="Wrap"
                           Visibility="{Binding FlavorText, ElementName=Root, Converter={StaticResource EmptyToCollapsed}}"
                           MaxHeight="46" Margin="0,3,0,0" />
                <TextBlock Text="{Binding BodyText, ElementName=Root}"
                           FontSize="11" Foreground="#FFDADEE6" TextWrapping="Wrap"
                           Visibility="{Binding BodyText, ElementName=Root, Converter={StaticResource EmptyToCollapsed}}"
                           MaxHeight="70" Margin="0,3,0,0" />
                <TextBlock Text="{Binding FooterText, ElementName=Root}"
                           FontWeight="Bold" FontSize="11" Foreground="{Binding AccentBrush, ElementName=Root}"
                           Visibility="{Binding FooterText, ElementName=Root, Converter={StaticResource EmptyToCollapsed}}"
                           HorizontalAlignment="Right" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
